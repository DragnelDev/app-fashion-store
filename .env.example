# Copie este archivo a `.env`. NO se versiona.
# Nuxt lee las variables NUXT_* y las mapea a runtimeConfig (ver nuxt.config.ts).

# --- Base de datos -------------------------------------------------------------
NUXT_MONGODB_URI=mongodb://127.0.0.1:27017/vestiq

# --- Administración ------------------------------------------------------------
# Clave para los endpoints de admin (crear productos/categorías, subir imágenes de catálogo).
# Genere una larga y aleatoria:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_ADMIN_API_KEY=

# Poner en true SOLO si la app corre detrás de un proxy/CDN de confianza (Nginx, Cloudflare…)
# que define X-Forwarded-For; así el límite de peticiones identifica la IP real del cliente.
NUXT_TRUST_PROXY=false

# --- Almacenamiento de imágenes ------------------------------------------------
# "local" guarda en ./storage/uploads (solo desarrollo). "cloudinary" para producción.
NUXT_STORAGE_DRIVER=local
NUXT_CLOUDINARY_CLOUD_NAME=
NUXT_CLOUDINARY_API_KEY=
NUXT_CLOUDINARY_API_SECRET=
NUXT_CLOUDINARY_FOLDER=vestiq
NUXT_PUBLIC_UPLOAD_MAX_MB=5

# --- Datos de cobro mostrados en el checkout -----------------------------------
NUXT_PUBLIC_PAGO_QR_IMAGE_URL=/qr/pago-qr.svg
NUXT_PUBLIC_PAGO_QR_BANCOS=Simple QR · Banco Bisa · BCP · BNB
NUXT_PUBLIC_PAGO_TITULAR=Vestiq S.R.L.
NUXT_PUBLIC_PAGO_TRANSFERENCIA_BANCO=
NUXT_PUBLIC_PAGO_TRANSFERENCIA_CUENTA=
NUXT_PUBLIC_PAGO_WHATSAPP=
