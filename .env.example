# Copie este archivo a `.env`. NO se versiona.
# Nuxt lee las variables NUXT_* y las mapea a runtimeConfig (ver nuxt.config.ts).

# --- Base de datos -------------------------------------------------------------
# Las TRANSACCIONES (descuento de stock + creación del pedido) requieren un replica set:
# Atlas ya lo es; en local use `docker compose up -d` (ver docker-compose.yml) con
#   NUXT_MONGODB_URI=mongodb://127.0.0.1:27017/vestiq?replicaSet=rs0&directConnection=true
# Un `mongod` standalone funciona en desarrollo (reserva atómica + compensación) pero sin transacciones.
NUXT_MONGODB_URI=mongodb://127.0.0.1:27017/vestiq

# --- Sesiones y administración -------------------------------------------------
# Firma las cookies de sesión. Obligatorio en producción (≥ 32 caracteres):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_SESSION_SECRET=

# Primer administrador: se crea al arrancar si no existe (no modifica usuarios existentes).
# Después del primer arranque puede retirar NUXT_ADMIN_PASSWORD del entorno.
# Contraseña: 8-72 caracteres con al menos una letra y un número.
NUXT_ADMIN_EMAIL=admin@vestiq.bo
NUXT_ADMIN_PASSWORD=

# Poner en true SOLO si la app corre detrás de un proxy/CDN de confianza (Nginx, Cloudflare…)
# que define X-Forwarded-For / X-Forwarded-Proto; así el límite de peticiones identifica la IP
# real del cliente y la cookie de sesión se marca `Secure` bajo HTTPS.
NUXT_TRUST_PROXY=false

# --- Almacenamiento de imágenes ------------------------------------------------
# "local" guarda en ./storage/uploads (solo desarrollo). "cloudinary" para producción.
NUXT_STORAGE_DRIVER=local
NUXT_CLOUDINARY_CLOUD_NAME=
NUXT_CLOUDINARY_API_KEY=
NUXT_CLOUDINARY_API_SECRET=
NUXT_CLOUDINARY_FOLDER=vestiq
NUXT_PUBLIC_UPLOAD_MAX_MB=5

# --- Datos de cobro mostrados en el checkout -----------------------------------
NUXT_PUBLIC_PAGO_QR_IMAGE_URL=/qr/pago-qr.svg
NUXT_PUBLIC_PAGO_QR_BANCOS=Simple QR · Banco Bisa · BCP · BNB
NUXT_PUBLIC_PAGO_TITULAR=Vestiq S.R.L.
NUXT_PUBLIC_PAGO_TRANSFERENCIA_BANCO=
NUXT_PUBLIC_PAGO_TRANSFERENCIA_CUENTA=
NUXT_PUBLIC_PAGO_WHATSAPP=
